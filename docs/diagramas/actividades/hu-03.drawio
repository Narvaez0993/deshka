a «Después»" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=13;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="230" y="1450" width="140" height="52" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=9;strokeColor=#2D3748;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c36" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=9;strokeColor=#2D3748;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c38" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="Marca la configuración como terminada" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=13;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="440" y="1590" width="240" height="54" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=9;strokeColor=#2D3748;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c28" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="Abre «Inicio»: «Cuéntame tu primer gasto» y $1.200.000 en sus cuentas" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=13;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="440" y="1674" width="240" height="71" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=9;strokeColor=#2D3748;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c41" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="