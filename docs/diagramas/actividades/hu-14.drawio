eometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="Muestra el formulario manual en la pestaña «Gasto»" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=13;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="440" y="260" width="240" height="54" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=9;strokeColor=#2D3748;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="Toca la pestaña «Ingreso»" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=13;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="80" y="344" width="240" height="52" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=9;strokeColor=#2D3748;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="Cambia «Sale de» por «Entra a», con solo cuentas, y muestra las categorías de ingreso" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=13;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#2D3748;" vertex="1" parent="1"><mxGeometry x="440" y="426" width="240" height="71" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=9;strokeColor=#2D3748;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="Escribe 3.000.000 y «Salario», deja la categoría Salario, elige Nómina en «Entra a» y toca «Guardar ingreso»" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontSize=13;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF