@startuml diagrama-de-clases
' ---------------------------------------------------------------------------
'  Deshka · Diagrama de clases de diseño
'  Entregable #1 · Diseño de Sistemas de Información · ITM · 2026
'
'  Vista general: las entidades del dominio, sus atributos esenciales, las
'  operaciones que definen su comportamiento y las relaciones entre ellas.
'  La versión exhaustiva (objetos de valor, derivados y puertos de la
'  arquitectura hexagonal) está en diagrama-de-clases-detallado.puml
' ---------------------------------------------------------------------------
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 55
skinparam class {
  BorderColor #1F3864
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #EEF2F9
  ArrowColor #45506B
  FontColor #14203A
  AttributeFontColor #33415C
}
skinparam enum {
  BorderColor #0E8A16
  BackgroundColor #F4FBF5
  HeaderBackgroundColor #E7F5EA
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #D4A017
}
hide circle

class User {
  - id : UUID
  + email : String
  + displayName : String
  + tier : Tier
  + language : String
  + currency : String
  + objective : String
  --
  + isPlus() : Boolean
  + canCreate(recurso : String) : Boolean
}

abstract class FundingSource {
  - id : String
  + name : String
  + currency : String
  --
  + {abstract} applyDelta(monto : Integer) : void
}

class Account {
  + kind : AccountKind
  + balance : Integer
  --
  + balance = saldo inicial + Σ movimientos
}

class CreditCard {
  + debt : Integer
  + limit : Integer
  + cutoffDay : Integer
  + dueDay : Integer
  --
  + available() : Integer
  + isOverLimit() : Boolean
}

class Goal {
  + target : Integer
  + targetDate : Date
  + archivedAt : DateTime
  --
  + saved() : Integer
  + progress(hoy : Date) : Float
  + projectedOn() : Date
  + archive() : void
}

class Movement {
  - id : String
  + type : MovementType
  + description : String
  + amount : Integer
  + occurredOn : Date
  --
  + apply() : void
  + edit(cambios : Movement) : void
  + revert() : void
}

class Category {
  - id : String
  + name : String
  + flow : CategoryFlow
  + isStandard : Boolean
}

class Budget {
  - id : String
  + scope : BudgetScope
  + target : Integer
  --
  + spent(periodo : String) : Integer
  + remaining(periodo : String) : Integer
  + perDay(hoy : Date) : Integer
  + projected(hoy : Date) : Integer
}

class Subscription {
  - id : String
  + name : String
  + amount : Integer
  + frequency : Frequency
  + firstChargeOn : Date
  + active : Boolean
  --
  + nextChargeOn(desde : Date) : Date
  + pause() : void
}

class SubscriptionCharge {
  - id : String
  + dueOn : Date
  + amount : Integer
  + status : ChargeStatus
  --
  + confirm() : Movement
  + settleAuto() : Movement
  + skip() : void
}

class Debt {
  - id : String
  + direction : DebtDirection
  + amount : Integer
  + dueOn : Date
  + note : String
  --
  + remaining() : Integer
  + status(hoy : Date) : DebtStatus
  + writeOff(fecha : Date) : void
}

class Counterparty {
  - id : String
  + name : String
}

class SharedEvent {
  - id : String
  + name : String
  + total : Integer
  + occurredOn : Date
  --
  + split(monto : Integer, entre : Counterparty [1..*]) : Debt [1..*]
}

class AgentOutput {
  - id : String
  + kind : OutputKind
  + period : String
  + createdAt : DateTime
  --
  + plays() : Play [0..*]
  + dismiss() : void
}

class Play {
  - id : String
  + action : String
  + text : String
  + status : PlayStatus
  --
  + apply() : void
}

class MovementDraft {
  - id : String
  + amount : Integer
  + description : String
  + status : DraftStatus
  --
  + confirm() : Movement
  + discard() : void
}

class AIUsageCounters {
  + period : String
  + registrationsUsed : Integer
  + messagesUsed : Integer
  --
  + consume(tipo : String) : void
  + remaining(tier : Tier) : Integer
}

package "enumeraciones" as P_ENUM {
  enum MovementType <<enumeration>> {
    expense
    income
    transfer
  }
  enum AccountKind <<enumeration>> {
    debit
    cash
  }
  enum CategoryFlow <<enumeration>> {
    expense
    income
  }
  enum BudgetScope <<enumeration>> {
    global
    category
  }
  enum Frequency <<enumeration>> {
    weekly
    monthly
    yearly
  }
  enum ChargeStatus <<enumeration>> {
    pending
    confirmed
    auto
    skipped
  }
  enum DebtDirection <<enumeration>> {
    incoming
    outgoing
  }
  enum DebtStatus <<enumeration>> {
    pending
    partial
    paid
    overdue
    written_off
  }
  enum DraftStatus <<enumeration>> {
    pending
    confirmed
    discarded
  }
  enum PlayStatus <<enumeration>> {
    proposed
    applying
    applied
    failed
  }
  enum OutputKind <<enumeration>> {
    monthly_summary
    weekly_review
  }
  enum Tier <<enumeration>> {
    free
    plus
  }
}

' --- herencia ---------------------------------------------------------------
FundingSource <|-- Account
FundingSource <|-- CreditCard
FundingSource <|-- Goal

' --- el usuario es dueño de todo --------------------------------------------
User "1" *-- "0..*" FundingSource : posee
User "1" *-- "0..*" Movement : registra
User "1" *-- "0..*" Category : personaliza
User "1" *-- "0..*" Budget : define
User "1" *-- "0..*" Subscription : contrata
User "1" *-- "0..*" Debt : acuerda
User "1" *-- "0..*" AgentOutput : recibe
User "1" *-- "1" AIUsageCounters : consume por mes

' --- el libro mayor ---------------------------------------------------------
Movement "0..*" --> "1" FundingSource : origen
Movement "0..*" --> "0..1" FundingSource : destino
Movement "0..*" --> "0..1" Category : clasifica
Movement ..> MovementType
User ..> Tier
Account ..> AccountKind
Category ..> CategoryFlow
Budget ..> BudgetScope
Subscription ..> Frequency
SubscriptionCharge ..> ChargeStatus
Debt ..> DebtDirection
Debt ..> DebtStatus
MovementDraft ..> DraftStatus
Play ..> PlayStatus
AgentOutput ..> OutputKind

' --- presupuestos -----------------------------------------------------------
Budget "0..*" --> "0..1" Category : vigila

' --- suscripciones ----------------------------------------------------------
Subscription "1" *-- "0..*" SubscriptionCharge : abre
SubscriptionCharge "0..1" --> "0..1" Movement : liquida en

' --- deudas -----------------------------------------------------------------
Debt "0..*" --> "1" Counterparty : con
SharedEvent "1" o-- "1..*" Debt : divide en

' --- el agente --------------------------------------------------------------
AgentOutput "1" *-- "0..*" Play : propone
MovementDraft "0..1" --> "0..1" Movement : se confirma en
User "1" *-- "0..*" MovementDraft : dicta

' --- notas ------------------------------------------------------------------
note top of FundingSource
  Toda fuente de dinero comparte el mismo
  contrato: recibe un **delta** y lo aplica.
  Una cuenta suma al saldo, una tarjeta
  **resta** a la deuda. De ahí sale el
  cash-basis sin casos especiales.
end note

note right of Movement
  **RN-01 · Cash-basis de tarjeta**
  `amount` siempre positivo: el signo lo da `type`.
  · Consumo con tarjeta = **expense** → sube la deuda
    y cuenta al presupuesto.
  · Pago de la tarjeta = **transfer** cuenta → tarjeta
    → baja la deuda y **no** vuelve a contar.
  · Aporte a meta = **transfer** cuenta → meta.
  · Préstamo a alguien = **transfer** cuenta → deuda.
end note

note bottom of Debt
  **RN-10** El registro de una deuda no mueve
  plata ni toca saldos. `remaining` y `status`
  se **derivan** de los abonos, nunca se guardan.
end note

note bottom of Goal
  **RN-14** `saved` se deriva de los movimientos
  de la meta. Un valor guardado se desactualiza
  en cuanto el usuario edite un aporte.
end note

note right of Play
  **RN-22** El agente **propone**; el usuario
  confirma. Nada modifica datos financieros
  sin una acción explícita.
end note

@enduml
