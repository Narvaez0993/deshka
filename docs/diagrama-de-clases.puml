@startuml diagrama-de-clases
' ---------------------------------------------------------------------------
'  Deshka · Diagrama de clases de diseño
'  Entregable #1 · Diseño de Sistemas de Información · ITM
'
'  Vista general en español: las trece clases que sostienen el sistema, con
'  sus atributos, sus operaciones y las relaciones entre ellas.
'  El color agrupa por área; la leyenda del pie lo explica.
' ---------------------------------------------------------------------------
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 65
skinparam defaultFontSize 14
skinparam ArrowColor #55607A
skinparam ArrowFontSize 12
skinparam ArrowFontColor #3C4661
skinparam class {
  BorderColor #2B3554
  BorderThickness 1.4
  FontSize 15
  FontStyle bold
  FontColor #101828
  AttributeFontSize 13
  AttributeFontColor #2B3554
  HeaderBackgroundColor #FFFFFF
}
skinparam enum {
  BorderColor #1F7A63
  BackgroundColor #EAF7F2
  FontSize 14
  AttributeFontSize 13
}
skinparam note {
  BackgroundColor #FFF7E0
  BorderColor #C9922A
  FontSize 13
}
skinparam legend {
  BackgroundColor #FBFCFE
  BorderColor #B8C0D0
  FontSize 13
}
hide circle

' ===========================================================================
class "Usuario" as Usuario #EDF0FF {
  + correo : Texto
  + nombre : Texto
  + plan : Texto
  + moneda : Texto
  --
  + esDePago() : Booleano
  + puedeCrear(recurso : Texto) : Booleano
}

abstract class "Fuente de dinero" as Fuente #E8F6F1 {
  + nombre : Texto
  --
  + {abstract} aplicar(m : Movimiento)
}

class "Cuenta" as Cuenta #E8F6F1 {
  + tipo : Texto
  + saldo : Dinero
}

class "Tarjeta de crédito" as Tarjeta #E8F6F1 {
  + deuda : Dinero
  + cupo : Dinero
  + díaDeCorte : Número
  + díaDePago : Número
  --
  + disponible() : Dinero
}

class "Meta de ahorro" as Meta #E8F6F1 {
  + nombre : Texto
  + objetivo : Dinero
  + fechaObjetivo : Fecha
  --
  + ahorrado() : Dinero
  + progreso() : Número
}

class "Movimiento" as Movimiento #F2ECFF {
  + tipo : TipoDeMovimiento
  + descripción : Texto
  + monto : Dinero
  + fecha : Fecha
  --
  + aplicar()
  + revertir()
}

class "Categoría" as Categoria #F2ECFF {
  + nombre : Texto
  + esDeGasto : Booleano
}

class "Tope de gasto" as Tope #FFF1E3 {
  + esGlobal : Booleano
  + tope : Dinero
  --
  + gastado(mes : Texto) : Dinero
  + restante(mes : Texto) : Dinero
  + porDía(hoy : Fecha) : Dinero
}

class "Suscripción" as Suscripcion #FFF1E3 {
  + nombre : Texto
  + monto : Dinero
  + frecuencia : Texto
  + activa : Booleano
  --
  + próximoCobro(desde : Fecha) : Fecha
  + pausar()
}

class "Cobro" as Cobro #FFF1E3 {
  + fecha : Fecha
  + monto : Dinero
  + estado : EstadoDeCobro
  --
  + confirmar() : Movimiento
  + omitir()
}

class "Deuda" as Deuda #FFECEF {
  + meDeben : Booleano
  + monto : Dinero
  + fechaLímite : Fecha
  --
  + saldoPendiente() : Dinero
  + estado(hoy : Fecha) : EstadoDeDeuda
}

class "Persona" as Persona #FFECEF {
  + nombre : Texto
}

class "Entrega del agente" as Entrega #E9F1FF {
  + tipo : Texto
  + periodo : Texto
  + fecha : Fecha
  --
  + sugerencias() : Número
  + aplicarSugerencia(n : Número)
}

' ===========================================================================
enum "TipoDeMovimiento" as TipoMov {
  gasto
  ingreso
  traslado
}

enum "EstadoDeCobro" as EstadoCobro {
  pendiente
  confirmado
  automático
  omitido
}

enum "EstadoDeDeuda" as EstadoDeuda {
  pendiente
  parcial
  pagada
  vencida
  incobrable
}

' ===========================================================================
' Herencia: los tres lugares donde puede estar la plata
' ===========================================================================
Fuente <|-- Cuenta
Fuente <|-- Tarjeta
Fuente <|-- Meta

' ===========================================================================
' El usuario es dueño de todo lo suyo
' ===========================================================================
Usuario "1" *-- "0..*" Fuente : posee
Usuario "1" *-- "0..*" Movimiento : registra
Usuario "1" *-- "0..*" Categoria : organiza
Usuario "1" *-- "0..*" Tope : define
Usuario "1" *-- "0..*" Suscripcion : contrata
Usuario "1" *-- "0..*" Deuda : acuerda
Usuario "1" *-- "0..*" Entrega : recibe

' ===========================================================================
' Cómo se mueve la plata
' ===========================================================================
Movimiento "0..*" --> "1" Fuente : sale de
Movimiento "0..*" --> "0..1" Fuente : entra a
Movimiento "0..*" --> "0..1" Categoria : se clasifica en
Tope "0..*" --> "0..1" Categoria : vigila
Suscripcion "1" *-- "0..*" Cobro : genera
Cobro "0..1" --> "0..1" Movimiento : se registra como
Deuda "0..*" --> "1" Persona : es con

Movimiento ..> TipoMov
Cobro ..> EstadoCobro
Deuda ..> EstadoDeuda

' ===========================================================================
note as N1
  **Pagar la tarjeta no es un gasto.**
  Comprar con la tarjeta sí: sube la deuda
  y cuenta al tope del mes. Pagarla es un
  **traslado** de la cuenta a la tarjeta, así
  que el mes no se encarece dos veces.
end note
N1 .. Movimiento

note as N2
  **Lo que se calcula no se guarda.**
  Lo ahorrado de una meta, el saldo de una
  deuda y lo gastado de un tope son
  **operaciones**, no atributos: se calculan
  en el momento y nunca quedan desactualizados.
end note
N2 .. Meta

legend bottom
  |= Qué agrupa cada color |
  |<#EDF0FF> Quién usa la app |
  |<#E8F6F1> Dónde está la plata |
  |<#F2ECFF> Lo que pasa con la plata |
  |<#FFF1E3> Límites y cobros que se repiten |
  |<#FFECEF> Plata con otras personas |
  |<#E9F1FF> El agente |
  |<#EAF7F2> Valores posibles (enumeraciones) |
endlegend

' Tipos usados: Texto · Dinero (entero en la unidad menor de la moneda) ·
' Número · Fecha · Booleano
@enduml
